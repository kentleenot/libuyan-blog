---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const title = "量化看板";
const description = "DeepSeek 自主交易的 BTC / ETH 永续模拟盘：价格线、因子面板、净值曲线、持仓与成交记录";
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={title}>
    <div class="q-wrap">
      <div class="q-bar">
        <span class="q-dot" id="q-dot"></span>
        <span id="q-status">连接中</span>
        <span class="q-tag" id="q-src">数据源 —</span>
        <span class="q-tag" id="q-upd">—</span>
        <span class="q-tag" id="q-mode">—</span>
      </div>

      <section class="q-card">
        <h2 id="q-acct-title">账户</h2>
        <div class="q-metrics">
          <div><span id="l-equity">净值</span><strong id="m-equity">—</strong></div>
          <div><span id="l-net">净盈亏</span><strong id="m-net">—</strong></div>
          <div><span id="l-upl">未实现盈亏</span><strong id="m-upl">—</strong></div>
          <div><span>可用</span><strong id="m-cash">—</strong></div>
          <div><span id="l-real">已实现</span><strong id="m-real">—</strong></div>
          <div><span id="l-fees">手续费</span><strong id="m-fees">—</strong></div>
          <div><span>总敞口</span><strong id="m-gross">—</strong></div>
          <div><span>杠杆</span><strong id="m-lev">—</strong></div>
          <div><span id="l-counts">持仓 / 平仓</span><strong id="m-counts">—</strong></div>
          <div><span>最大回撤</span><strong id="m-dd">—</strong></div>
          <div><span>今日盈亏</span><strong id="m-day">—</strong></div>
        </div>
        <div class="q-risk">
          <div class="q-risk-bar"><i id="q-risk-fill"></i></div>
          <small id="q-risk-text">日止损上限 —</small>
        </div>
      </section>

      <div class="q-grid" id="q-markets"></div>

      <section class="q-card">
        <h2>趋势面板 · 200 日均线（只做多）</h2>
        <div class="q-tablewrap">
          <table><thead><tr><th>品种</th><th>最新价</th><th>MA200</th><th>距均线</th><th>状态</th></tr></thead>
          <tbody id="q-factors"><tr><td colspan="5" class="q-dim">等待信号</td></tr></tbody></table>
        </div>
        <p class="q-note" id="q-factor-note">规则：价格在 200 日均线上方 → 持多；跌破 → 离场。按距均线强度排序，最多持 4 个品种，单笔 25% 净值。</p>
      </section>

      <section class="q-card">
        <h2>AI 自选因子（每 6 小时自我复盘）</h2>
        <div id="q-factor-set" class="q-dim">等待 AI 选择…</div>
      </section>

      <section class="q-card">
        <h2>策略状态</h2>
        <div class="q-decision">
          <div><span>策略</span><strong id="d-action">—</strong></div>
          <div><span>均线上方品种</span><strong id="d-conf">—</strong></div>
          <div><span>持仓 / 上限</span><strong id="d-calls">—</strong></div>
          <div><span>今日盈亏 / 日止损</span><strong id="d-tokens">—</strong></div>
        </div>
        <p class="q-note">纯规则策略，不调用 LLM（0 token）。风控：止损 5% / 日亏 5 USDT / 总回撤 15% 熔断，全部由代码执行。</p>
      </section>

      <section class="q-card">
        <h2>净值曲线</h2>
        <div id="q-curve" class="q-chart"></div>
        <div class="q-curve-foot" id="q-curve-foot">等待净值记录（每分钟一条）</div>
      </section>

      <section class="q-card">
        <h2>持仓</h2>
        <div class="q-tablewrap">
          <table><thead><tr><th>标的 / 方向</th><th>开仓时间</th><th>开仓价</th><th>数量</th><th>名义</th><th>止损 / 止盈</th><th>浮动盈亏</th></tr></thead>
          <tbody id="q-pos"><tr><td colspan="7" class="q-dim">暂无持仓</td></tr></tbody></table>
        </div>
      </section>

      <section class="q-card">
        <h2>成交记录</h2>
        <div class="q-tablewrap">
          <table><thead><tr><th>标的 / 方向</th><th>开仓 → 平仓价</th><th>数量</th><th>手续费</th><th>净盈亏</th><th>平仓原因</th></tr></thead>
          <tbody id="q-trades"><tr><td colspan="6" class="q-dim">暂无成交</td></tr></tbody></table>
        </div>
      </section>

      <section class="q-card">
        <h2>运行记录</h2>
        <div id="q-events" class="q-events q-dim">等待事件</div>
      </section>

      <p class="q-note" id="q-disclaimer">行情来自公开接口；账户与下单由服务端签名，密钥不下发浏览器。本页仅供研究，不构成投资建议。</p>
    </div>
  </Main>
  <Footer />
</Layout>

<script define:vars={{ API: import.meta.env.PUBLIC_QUANT_API || "" }}>
  const el = (id) => document.getElementById(id);
  const money = (v, signed) => (v == null || isNaN(v)) ? "—" : ((signed && v > 0 ? "+" : "") + Number(v).toFixed(2) + " U");
  const pct = (v, d) => (v == null || isNaN(v)) ? "—" : (Number(v) * 100).toFixed(d == null ? 2 : d) + "%";
  const num = (v, d) => (v == null || isNaN(v)) ? "—" : Number(v).toFixed(d == null ? 2 : d);
  const px = (v) => (v == null || isNaN(v)) ? "—" : Number(v).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const t = (ms) => ms ? new Date(Number(ms)).toLocaleString("zh-CN", { month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false }) : "—";
  const cls = (v) => v > 0 ? "q-up" : v < 0 ? "q-down" : "";
  const NAME = { "SPY-USDT-SWAP": "SPY 标普500", "QQQ-USDT-SWAP": "QQQ 纳指100", "NVDA-USDT-SWAP": "NVDA 英伟达",
    "AAPL-USDT-SWAP": "AAPL 苹果", "MSFT-USDT-SWAP": "MSFT 微软", "META-USDT-SWAP": "META", "AMZN-USDT-SWAP": "AMZN 亚马逊", "TSLA-USDT-SWAP": "TSLA 特斯拉" };
  const evName = { OPEN: "开仓", CLOSE: "平仓" };
  const rsName = { stop_loss: "止损", take_profit: "止盈", horizon_exit: "到期平仓", deepseek_close: "DeepSeek 平仓", hold: "观望" };
  const FACTORS = [
    ["ret3", "3 根动量(45分)"], ["ret30", "30 根动量(7.5h)"], ["ret60", "60 根动量(15h)"],
    ["ma15", "距 15 均线"], ["ma60", "距 60 均线"], ["rsi14", "RSI(14)"],
    ["vol15", "15 波动率"], ["vol60", "60 波动率"], ["volTrend", "成交量趋势"]
  ];

  async function get(path) {
    const r = await fetch((API || "") + path, { cache: "no-store" });
    return r.json();
  }

  function spark(points, h) {
    if (!points || points.length < 3) return '<div class="q-spark-empty">价格线积累中（每分钟一点，约 1 小时后成形）</div>';
    const vs = points.map((p) => p.p);
    let lo = Math.min.apply(null, vs), hi = Math.max.apply(null, vs);
    const pad = Math.max((hi - lo) * 0.12, Math.abs(hi) * 0.0002);
    lo -= pad; hi += pad;
    const X = (i) => (i / (points.length - 1) * 1000).toFixed(1);
    const Y = (v) => (h - 14 - (v - lo) / (hi - lo) * (h - 26)).toFixed(1);
    const d = points.map((p, i) => (i ? "L" : "M") + " " + X(i) + " " + Y(p.p)).join(" ");
    const up = vs[vs.length - 1] >= vs[0];
    const color = up ? "#16a34a" : "#dc2626";
    return '<svg viewBox="0 0 1000 ' + h + '" preserveAspectRatio="none" class="q-chart-svg"><path d="' + d + '" fill="none" stroke="' + color + '" stroke-width="1.8" vector-effect="non-scaling-stroke"/></svg>';
  }

  function renderMarkets(s) {
    const hist = s.priceHist || {};
    const sig = s.signals || [];
    el("q-markets").innerHTML = sig.map((g) => {
      const hp = hist[g.asset] || [];
      const first = hp.length ? hp[0].p : null, last = hp.length ? hp[hp.length - 1].p : null;
      const chg = (first && last) ? (last / first - 1) : null;
      const spread = (g.bid && g.ask) ? (g.ask - g.bid) / ((g.ask + g.bid) / 2) : null;
      const pos = (s.positions || []).filter((x) => x.asset === g.asset);
      const amount = pos.length ? pos.reduce((n, x) => n + (x.notional || 0), 0) : null;
      const act = g.action || "—";
      const actCls = act.indexOf("LONG") >= 0 ? "q-up" : act.indexOf("SHORT") >= 0 ? "q-down" : "";
      const dist = (g.ma200 && g.last) ? (g.last / g.ma200 - 1) : null;
      return '<article class="q-card">' +
        '<div class="q-mtitle"><h2>' + (NAME[g.asset] || g.asset) + ' / USDT 永续</h2><span class="' + cls(chg) + '">' + (chg == null ? "—" : (chg > 0 ? "+" : "") + pct(chg)) + '</span></div>' +
        '<div class="q-price"><span class="q-big">' + px(g.last) + '</span><small>买 ' + px(g.bid) + ' / 卖 ' + px(g.ask) + '</small></div>' +
        spark(hp, 120) +
        '<div class="q-row"><span>趋势信号</span><b class="' + (g.aboveMA ? "q-up" : "q-down") + '">' + (g.aboveMA == null ? "无数据" : (g.aboveMA ? "MA200 上方 · 持多" : "MA200 下方 · 离场")) + '</b></div>' +
        '<div class="q-row"><span>MA200</span><b>' + (g.ma200 == null ? "—" : px(g.ma200)) + '</b></div>' +
        '<div class="q-row"><span>距均线</span><b class="' + cls(dist) + '">' + (dist == null ? "—" : (dist > 0 ? "+" : "") + pct(dist)) + '</b></div>' +
        '<div class="q-row"><span>当前持仓金额</span><b>' + (amount != null ? money(amount) : "—") + '</b></div>' +
        '<div class="q-row"><span>止损 / 止盈（AI 设定）</span><b>' + ((s.levels && s.levels[g.asset]) ? (pct(s.levels[g.asset].stop) + ' / ' + pct(s.levels[g.asset].target)) : "—") + '</b></div>' +
        '<div class="q-row"><span>买卖点差</span><b>' + (spread == null ? "—" : pct(spread, 3)) + '</b></div>' +
        '<div class="q-decision-note">' + (g.aboveMA ? "趋势向上，按强度排序纳入持仓" : "未达条件，观望") + '</div>' +
        '</article>';
    }).join("");
  }

  function renderFactors(s) {
    const sig = (s.signals || []).slice().sort((x, y) => {
      const ax = (x.ma200 && x.last) ? x.last / x.ma200 : -9, ay = (y.ma200 && y.last) ? y.last / y.ma200 : -9;
      return ay - ax;
    });
    el("q-factors").innerHTML = sig.map((g) => {
      const d = (g.ma200 && g.last) ? (g.last / g.ma200 - 1) : null;
      const held = (s.positions || []).some((x) => x.asset === g.asset);
      const st = held ? "持仓中" : (g.aboveMA === true ? "候选" : (g.aboveMA === false ? "观望" : "无数据"));
      const stCls = held ? "q-up" : (g.aboveMA === true ? "" : "q-dim");
      return '<tr><td><b>' + (NAME[g.asset] || g.asset) + '</b></td>' +
        '<td>' + px(g.last) + '</td><td>' + (g.ma200 == null ? "—" : px(g.ma200)) + '</td>' +
        '<td class="' + cls(d) + '">' + (d == null ? "—" : (d > 0 ? "+" : "") + pct(d)) + '</td>' +
        '<td class="' + stCls + '">' + st + '</td></tr>';
    }).join("") || '<tr><td colspan="5" class="q-dim">等待信号</td></tr>';
  }

  function renderPositions(s) {
    if (!s.positions || !s.positions.length) { el("q-pos").innerHTML = '<tr><td colspan="7" class="q-dim">暂无持仓</td></tr>'; return; }
    el("q-pos").innerHTML = s.positions.map((p) => '<tr><td><b>' + (NAME[p.asset] || p.asset) + '</b> <span class="' + (p.side === "LONG" ? "q-up" : "q-down") + '">' + p.side + '</span></td>' +
      '<td>' + t(p.openedAt) + '</td><td>' + px(p.entry) + '</td><td>' + num(p.qty, 5) + '</td><td>' + money(p.notional) + '</td>' +
      '<td>' + pct(p.stopPct) + ' / ' + pct(p.targetPct) + '</td>' +
      '<td class="' + cls(p.upl != null ? p.upl : p.last_mark) + '">' + money(p.upl != null ? p.upl : p.last_mark, true) + (p.lever ? ' <small>' + p.lever + '×</small>' : '') + '</td></tr>').join("");
  }

  function renderTrades(s) {
    if (!s.trades || !s.trades.length) { el("q-trades").innerHTML = '<tr><td colspan="6" class="q-dim">暂无成交（DeepSeek 还没开过仓）</td></tr>'; return; }
    el("q-trades").innerHTML = s.trades.map((x) => '<tr><td><b>' + (NAME[x.asset] || x.asset) + '</b> <span class="' + (x.side === "LONG" ? "q-up" : "q-down") + '">' + x.side + '</span></td>' +
      '<td>' + px(x.entry) + ' → ' + px(x.exit) + '</td><td>' + num(x.qty, 5) + '</td><td>' + money(x.fee) + '</td>' +
      '<td class="' + cls(x.net) + '">' + money(x.net, true) + '</td><td>' + (rsName[x.reason] || x.reason) + '</td></tr>').join("");
  }

  function renderEvents(s) {
    if (!s.events || !s.events.length) { el("q-events").textContent = "等待事件"; return; }
    el("q-events").innerHTML = s.events.slice(0, 12).map((e) =>
      '<div class="q-ev"><small>' + t(e.ts) + ' · ' + (NAME[e.asset] || "") + '</small> ' +
      (evName[e.type] || e.type) + ' · ' + (rsName[e.reason] || e.reason) + '</div>').join("");
  }

  function renderState(s) {
    const a = s.account || {}, c = s.config || {}, ad = s.advisor || {}, d = s.day || {};
    el("q-dot").classList.add("q-on");
    el("q-status").textContent = s.halt_reason === "daily_loss_limit" ? "已触发日止损 · 今日停止新仓" : (s.status === "RUNNING" ? "运行中" : (s.status || "—"));
    el("q-src").textContent = "数据源 " + (s.quoteSource || "—") + (s.quoteNote ? "（" + s.quoteNote + "）" : "");
    el("q-upd").textContent = "行情 " + t(a.last_success);
    const mode = el("q-mode");
    if (s.live) { mode.textContent = "实盘 LIVE"; mode.className = "q-tag live"; }
    else { mode.textContent = "模拟 PAPER"; mode.className = "q-tag"; }
    el("q-acct-title").textContent = s.live ? "真实账户（OKX 实盘）" : "模拟账户";
    if (s.live) el("q-disclaimer").textContent = "实盘模式：真实资金、真实市价单（全仓 3×，单笔 20 USDT，最多 2 仓）。风控：止损 1.2% / 止盈 2.5% / 15 分钟到期 / 日亏 5 USDT 停止开仓。密钥不下发浏览器。";
    el("m-equity").textContent = money(a.equity);
    if (s.live && a.live_base != null) el("m-equity").title = "基准 " + money(a.live_base);
    const net = el("m-net"); net.textContent = money(a.net_pnl, true); net.className = cls(a.net_pnl);
    const real = el("m-real"); real.textContent = money(a.realized_pnl, true); real.className = cls(a.realized_pnl);
    const upl = el("m-upl"); upl.textContent = money(a.unrealized_pnl != null ? a.unrealized_pnl : 0, true); upl.className = cls(a.unrealized_pnl);
    el("m-cash").textContent = money(a.available);
    el("m-fees").textContent = money(a.fees_paid);
    el("m-gross").textContent = a.gross_exposure ? money(a.gross_exposure) : "—";
    el("m-lev").textContent = a.gross_leverage ? (Number(a.gross_leverage).toFixed(2) + "×") : "—";
    el("m-counts").textContent = (a.open_positions || 0) + (a.closed_trades == null ? " / —" : " / " + a.closed_trades);
    if (s.live) {
      el("l-equity").textContent = "真实权益";
      el("l-net").textContent = "自启动净盈亏";
      el("l-real").textContent = (a.realized_pnl == null ? "已实现（OKX）" : "已实现");
      el("l-counts").textContent = "持仓 / 平仓（OKX）";
    }
    el("m-dd").textContent = pct(a.max_drawdown);
    const dayLoss = d.loss || 0, limit = (d.limitU || c.dailyLossU || 5);
    const pnlToday = -dayLoss;
    const day = el("m-day"); day.textContent = money(pnlToday, true); day.className = cls(pnlToday);
    el("q-risk-fill").style.width = Math.min(100, Math.max(0, dayLoss / limit * 100)) + "%";
    el("q-risk-text").textContent = "日止损上限 " + money(limit) + "（已用 " + Math.max(0, dayLoss / limit * 100).toFixed(0) + "%）";
    const fs = s.factorSet;
    el("q-factor-set").innerHTML = (fs && fs.picks && fs.picks.length)
      ? '<b>' + fs.picks.join(" · ") + '</b>' + (fs.note ? '<div class="q-decision-note">' + fs.note + ' · ' + t(fs.at) + '</div>' : '')
      : '等待 AI 首次选择（约 6 小时内生成）——AI 会从 54 个指标里挑出当前最有效的，并在后续判断中重点参考。';
    const sigAll = s.signals || [];
    const aboveN = sigAll.filter((g) => g.aboveMA === true).length;
    el("d-action").textContent = (sigAll[0] && sigAll[0].strategy) ? (sigAll[0].strategy === "trend" ? "趋势 · MA200 · 只做多" : sigAll[0].strategy) : "趋势 · MA200";
    el("d-conf").textContent = aboveN + " / " + sigAll.length;
    el("d-calls").textContent = (a.open_positions || 0) + " / " + ((c.maxPositions) || 4);
    el("d-tokens").textContent = money(pnlToday) + " / " + money(limit);
    renderMarkets(s); renderFactors(s); renderPositions(s); renderTrades(s); renderEvents(s);
  }

  function drawCurve(points) {
    if (!points || !points.length) { el("q-curve").innerHTML = ""; el("q-curve-foot").textContent = "等待净值记录（每分钟一条）"; return; }
    const vs = points.map((p) => p.equity);
    let lo = Math.min.apply(null, vs), hi = Math.max.apply(null, vs);
    const pad = Math.max((hi - lo) * 0.1, 0.05); lo -= pad; hi += pad;
    const X = (i) => points.length === 1 ? 500 : i / (points.length - 1) * 1000;
    const Y = (v) => 150 - (v - lo) / (hi - lo) * 130;
    const d = points.map((p, i) => (i ? "L" : "M") + " " + X(i).toFixed(1) + " " + Y(p.equity).toFixed(1)).join(" ");
    el("q-curve").innerHTML = '<svg viewBox="0 0 1000 160" preserveAspectRatio="none" role="img" aria-label="模拟账户净值曲线"><path d="' + d + '" fill="none" stroke="var(--accent)" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>';
    el("q-curve-foot").textContent = points.length + " 个净值点 · 最新 " + money(vs[vs.length - 1]);
  }

  async function refresh() {
    try {
      const s = await get("/api/state");
      if (s && s.ok) renderState(s); else throw new Error("state");
    } catch (e) {
      el("q-dot").classList.remove("q-on");
      el("q-status").textContent = "后端暂不可用";
    }
  }
  async function refreshCurve() {
    try { const d = await get("/api/equity"); if (d && d.ok) drawCurve(d.equity || []); } catch (e) {}
  }
  refresh(); refreshCurve();
  setInterval(refresh, 10000);
  setInterval(refreshCurve, 60000);
</script>

<style>
  .q-wrap { display: flex; flex-direction: column; gap: 14px; }
  .q-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--muted-foreground); }
  .q-dot { width: 8px; height: 8px; border-radius: 50%; background: #9ca3af; display: inline-block; }
  .q-dot.q-on { background: #16a34a; box-shadow: 0 0 8px rgba(22,163,74,.6); }
  .q-tag { border: 1px solid var(--border); border-radius: 999px; padding: 1px 9px; font-size: 11px; color: var(--muted-foreground); }
  .q-tag.live { border-color: #dc2626; color: #dc2626; font-weight: 600; }
  :global(.dark) .q-tag.live { color: #f87171; border-color: #f87171; }
  .q-card { border: 1px solid var(--border); border-radius: 10px; padding: 14px; background: var(--muted); }
  .q-card h2 { margin: 0; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-foreground); font-weight: 600; }
  .q-mtitle { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .q-mtitle span { font-size: 12px; }
  .q-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
  .q-metrics { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); margin-top: 4px; }
  .q-metrics div { display: flex; flex-direction: column; gap: 2px; }
  .q-metrics span { font-size: 11px; color: var(--muted-foreground); }
  .q-metrics strong { font-size: 16px; color: var(--foreground); font-weight: 600; }
  .q-big { font-size: 22px; font-weight: 600; color: var(--foreground); }
